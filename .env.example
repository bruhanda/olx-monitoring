# --- Telegram (обов'язково) ---
TELEGRAM_BOT_TOKEN=123456:AA...
TELEGRAM_CHAT_ID=-1001234567890

# --- Сховище ---
DATABASE_PATH=./data/info-parser.db

# --- Веб-адмінка ---
HTTP_ADDR=:8088
# Порожні значення = без авторизації. Задавати обидва разом.
HTTP_BASIC_AUTH_USER=
HTTP_BASIC_AUTH_PASS=

# --- Розклад ---
# Час доби для перевірок, через кому. Порожнє значення = опитування за інтервалом.
DAILY_NOTIFY_TIMES=11:00,15:00,20:00
POLL_INTERVAL_SEC=60
# Максимум нових оголошень на один пошук за один запуск
MAX_ITEMS_PER_RUN=10

# --- Мережа ---
REQUEST_TIMEOUT_SEC=15
REQUEST_DELAY_SEC=3
REQUEST_JITTER_SEC=2
HTTP_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36

# --- Засівання пошуків (опційно, керувати краще через веб-форму) ---
# OLX_SEARCH_URLS=https://www.olx.ua/uk/list/q-dr-martens-1460/
# OLX_SEARCH_URLS_WITH_NAMES=Dr. Martens 1460|https://www.olx.ua/uk/list/q-dr-martens-1460/

# --- Діагностика ---
# OLX_DEBUG=1  # докладні логи парсера, включно з HTML карток

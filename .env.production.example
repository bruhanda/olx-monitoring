# Секрети для продакшину. На сервері: ~/server/olx.kozelets.pp.ua/.env.production
# chmod 600, у git НЕ комітиться.

TELEGRAM_BOT_TOKEN=123456:AA...
TELEGRAM_CHAT_ID=-1001234567890

# Авторизація адмінки — обов'язкова, сервіс публічний.
HTTP_BASIC_AUTH_USER=admin
HTTP_BASIC_AUTH_PASS=<згенеруй: openssl rand -base64 24>

# Розклад перевірок (локальний час контейнера, TZ=Europe/Kyiv)
DAILY_NOTIFY_TIMES=11:00,15:00,20:00
MAX_ITEMS_PER_RUN=10

# Мережа
REQUEST_TIMEOUT_SEC=15
REQUEST_DELAY_SEC=3
REQUEST_JITTER_SEC=2
